<Application x:Class="Cineleaf.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Strings.en.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="BackgroundColor">#101714</Color>
      <Color x:Key="PanelColor">#17211D</Color>
      <Color x:Key="ElevatedColor">#202C27</Color>
      <Color x:Key="AccentColor">#67D391</Color>
      <Color x:Key="TextColor">#F3F7F4</Color>
      <Color x:Key="MutedColor">#9AAC9F</Color>
      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
      <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
      <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
      <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
      <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#31423A"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#0F1814"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#3A4A43"/>
        <Setter Property="Padding" Value="7"/>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
        <Setter Property="Foreground" Value="#101714"/>
        <Setter Property="Padding" Value="6"/>
      </Style>
      <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
