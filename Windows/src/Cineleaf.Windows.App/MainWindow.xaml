<Window x:Class="Cineleaf.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cineleaf.Windows"
        Title="{DynamicResource AppName}" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="255"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A3932" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,6">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="{DynamicResource New}" Click="New_Click" ToolTip="Ctrl+N"/>
          <Button Content="{DynamicResource Open}" Click="Open_Click" ToolTip="Ctrl+O"/>
          <Button Content="{DynamicResource Save}" Click="Save_Click" ToolTip="Ctrl+S"/>
          <Separator Margin="5,4"/>
          <Button Content="{DynamicResource Import}" Click="Import_Click" ToolTip="Ctrl+I"/>
          <Button Content="{DynamicResource Undo}" Click="Undo_Click" ToolTip="Ctrl+Z"/>
          <Button Content="{DynamicResource Redo}" Click="Redo_Click" ToolTip="Ctrl+Y"/>
          <Button Content="{DynamicResource Split}" Click="Split_Click" ToolTip="Ctrl+B"/>
          <Button Content="{DynamicResource Text}" Click="AddText_Click"/>
          <Button Content="{DynamicResource Captions}" Click="Captions_Click"/>
          <Button Content="{DynamicResource SubtitlesImport}" Click="ImportSubtitles_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0"/>
          <ComboBox x:Name="LanguageBox" Width="100" SelectionChanged="LanguageBox_SelectionChanged">
            <ComboBoxItem Tag="system" Content="{DynamicResource SystemLanguage}"/><ComboBoxItem Tag="en" Content="{DynamicResource English}"/><ComboBoxItem Tag="es" Content="{DynamicResource Spanish}"/>
          </ComboBox>
          <Button Content="{DynamicResource Export}" Background="{StaticResource AccentBrush}" Foreground="#07110C" FontWeight="SemiBold" Click="Export_Click" ToolTip="Ctrl+E"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A3932" BorderThickness="0,0,1,0" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Media}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="{DynamicResource MediaHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,9"/>
          <ListBox x:Name="MediaList" Grid.Row="2" MouseDoubleClick="MediaList_MouseDoubleClick" PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown" PreviewMouseMove="MediaList_PreviewMouseMove" SelectionChanged="MediaList_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Background="{StaticResource ElevatedBrush}" CornerRadius="5" Margin="0,0,0,7" Padding="9">
                <StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="14,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Preview}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>
        <Border Grid.Row="1" Background="Black" CornerRadius="7" BorderBrush="#304039" BorderThickness="1">
          <Grid>
            <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="PreviewPlayer_MediaOpened" MediaEnded="PreviewPlayer_MediaEnded"/>
            <TextBlock x:Name="PreviewEmpty" Text="Cineleaf" Foreground="#688077" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="PlayButton" Content="▶ / ❚❚" Click="Play_Click" ToolTip="{DynamicResource PlayPause}"/>
          <Slider x:Name="PreviewSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="8,0" ValueChanged="PreviewSlider_ValueChanged"/>
          <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#2A3932" BorderThickness="1,0,0,0" Padding="13">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{DynamicResource Inspector}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="NoSelectionText" Text="{DynamicResource NoSelection}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel x:Name="InspectorPanel" Visibility="Collapsed">
              <TextBlock Text="{DynamicResource Name}"/><TextBox x:Name="ClipNameBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Start}"/><TextBox x:Name="StartBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Duration}"/><TextBox x:Name="DurationBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Speed}"/><TextBox x:Name="SpeedBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Opacity}"/><TextBox x:Name="OpacityBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Volume}"/><TextBox x:Name="VolumeBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Scale}"/><TextBox x:Name="ScaleBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Rotation}"/><TextBox x:Name="RotationBox" Margin="0,3,0,9"/>
              <TextBlock Text="{DynamicResource Text}"/><TextBox x:Name="TextContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,3,0,9"/>
              <Button Content="{DynamicResource Apply}" Background="{StaticResource AccentBrush}" Foreground="#07110C" Click="ApplyInspector_Click"/>
              <Separator Margin="0,9"/>
              <TextBlock Text="{DynamicResource Effect}"/>
              <ComboBox x:Name="EffectBox" Margin="0,4"><ComboBoxItem Tag="GaussianBlur">Blur</ComboBoxItem><ComboBoxItem Tag="Sharpen">Sharpen</ComboBoxItem><ComboBoxItem Tag="Vignette">Vignette</ComboBoxItem><ComboBoxItem Tag="Monochrome">Monochrome</ComboBoxItem><ComboBoxItem Tag="Sepia">Sepia</ComboBoxItem><ComboBoxItem Tag="Bloom">Bloom</ComboBoxItem></ComboBox>
              <Button Content="{DynamicResource AddEffect}" Click="AddEffect_Click"/>
              <WrapPanel><Button Content="{DynamicResource Duplicate}" Click="Duplicate_Click"/><Button Content="{DynamicResource RippleDelete}" Click="RippleDelete_Click"/><Button Content="{DynamicResource Marker}" Click="Marker_Click"/><Button Content="{DynamicResource FindBeats}" Click="FindBeats_Click"/><Button Content="{DynamicResource RemoveSilence}" Click="RemoveSilence_Click"/></WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" BorderBrush="#2A3932" BorderThickness="0,1,0,0">
      <local:TimelineControl x:Name="Timeline" ClipSelected="Timeline_ClipSelected" ClipMoveRequested="Timeline_ClipMoveRequested" AssetDropped="Timeline_AssetDropped"/>
    </Border>
    <Border Grid.Row="3" Background="#0C120F" Padding="10,3">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="{DynamicResource Ready}" Foreground="{StaticResource MutedBrush}"/>
        <ProgressBar x:Name="WorkProgress" Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Grid>
</Window>
